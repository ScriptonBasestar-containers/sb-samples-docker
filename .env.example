# ========================================
# sb-samples-websolution 환경 변수 템플릿
# ========================================
#
# 사용법:
# 1. 이 파일을 .env로 복사: cp .env.example .env
# 2. 필요한 값을 수정
# 3. docker-compose.yml에서 환경 변수 참조
#
# 주의: .env 파일은 git에 커밋하지 마세요!
# ========================================

# ========================================
# 포트 설정
# ========================================
# 여러 서비스를 동시에 실행할 경우 포트 충돌을 피하기 위해
# 각 서비스의 포트를 다르게 설정하세요.

# CMS & 블로그 플랫폼
WORDPRESS_PORT=8080
JOOMLA_PORT=8081
DRUPAL_PORT=8082

# 위키 시스템
DOKUWIKI_PORT=8083
DOKUWIKI_INSTALL_PORT=8084
MEDIAWIKI_PORT=8085
PHABRICATOR_PORT=8086

# 포럼 & 커뮤니티
FLARUM_PORT=8888

# 클라우드 스토리지
NEXTCLOUD_PORT=8087

# 데이터베이스 포트 (외부 노출용)
MARIADB_PORT=3306
MYSQL_PORT=3307
POSTGRES_PORT=5432

# 캐시 포트
REDIS_PORT=6379
MEMCACHED_PORT=11211
MEMCACHED_BITNAMI_PORT=11212
MEMCACHED_SAMEERSBN_PORT=11213

# Apache Ignite
IGNITE_CLIENT_PORT=11211
IGNITE_COMMUNICATION_PORT_START=47500
IGNITE_COMMUNICATION_PORT_END=47509

# ========================================
# 데이터베이스 설정
# ========================================

# MariaDB/MySQL 공통 설정
DB_ROOT_PASSWORD=rootpassword
DB_USER=dbuser
DB_PASSWORD=dbpassword

# WordPress
WORDPRESS_DB_NAME=bitnami_wordpress
WORDPRESS_DB_USER=bn_wordpress
WORDPRESS_DB_PASSWORD=wordpress_password

# Joomla
JOOMLA_DB_NAME=bitnami_joomla
JOOMLA_DB_USER=bn_joomla
JOOMLA_DB_PASSWORD=joomla_password

# Drupal
DRUPAL_DB_NAME=bitnami_drupal
DRUPAL_DB_USER=bn_drupal
DRUPAL_DB_PASSWORD=drupal_password

# MediaWiki
MEDIAWIKI_DB_NAME=bitnami_mediawiki
MEDIAWIKI_DB_USER=bn_mediawiki
MEDIAWIKI_DB_PASSWORD=mediawiki_password

# Nextcloud
NEXTCLOUD_DB_NAME=nextcloud_db
NEXTCLOUD_DB_USER=nextcloud
NEXTCLOUD_DB_PASSWORD=nextcloud_password

# Flarum
FLARUM_DB_NAME=bitnami_db
FLARUM_DB_USER=bn_user
FLARUM_DB_PASSWORD=flarum_password

# Phabricator
PHABRICATOR_DB_PASSWORD=phabricator_password

# ========================================
# Redis 설정
# ========================================
REDIS_PASSWORD=redis_password
REDIS_TLS_ENABLED=yes

# ========================================
# 애플리케이션 설정
# ========================================

# WordPress
WORDPRESS_USERNAME=admin
WORDPRESS_PASSWORD=admin_password
WORDPRESS_EMAIL=admin@example.com

# Joomla
JOOMLA_USERNAME=admin
JOOMLA_PASSWORD=admin_password
JOOMLA_EMAIL=admin@example.com

# Nextcloud
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=admin_password

# Flarum
FLARUM_ADMIN_USER=admin
FLARUM_ADMIN_PASS=adminpassword
FLARUM_ADMIN_MAIL=admin@test.co.kr
FLARUM_TITLE=My Flarum Forum
FLARUM_URL=http://localhost:8888

# Phabricator
PHABRICATOR_HOST=127.0.0.1
PHABRICATOR_USERNAME=user
PHABRICATOR_PASSWORD=bitnami1
PHABRICATOR_EMAIL=user@example.com
PHABRICATOR_FIRSTNAME=FirstName
PHABRICATOR_LASTNAME=LastName

# ========================================
# 기타 설정
# ========================================

# 타임존
TZ=Asia/Seoul

# PHP 설정
PHP_MEMORY_LIMIT=256M

# 개발 모드
DEBUG=false
ALLOW_EMPTY_PASSWORD=no

# ========================================
# 보안 주의사항
# ========================================
#
# 프로덕션 환경에서는:
# 1. 모든 기본 비밀번호를 강력한 비밀번호로 변경하세요
# 2. ALLOW_EMPTY_PASSWORD=no 로 설정하세요
# 3. DEBUG=false 로 설정하세요
# 4. 데이터베이스 포트를 외부에 노출하지 마세요
# 5. HTTPS를 사용하세요
#
# ========================================
